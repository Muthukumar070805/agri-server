# LLM Provider (ollama | mistral)
PROVIDER=ollama

# Mistral (if PROVIDER=mistral)
MISTRAL_API_KEY=your_key_here

# Ollama (if PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FLASH_MODEL=qwen3-coder-next:cloud
OLLAMA_REASONING_MODEL=qwen3-coder-next:cloud
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Pinecone
PINECONE_API_KEY=your_key_here
PINECONE_INDEX=scheme

# Session (optional)
SESSION_REDIS_ENABLED=false
SESSION_TTL_MINUTES=30

# Weather
WEATHER_LOCATION=Avadi

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
MAX_REQUEST_SIZE=10240
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60